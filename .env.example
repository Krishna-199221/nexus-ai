# ==========================================
# NEXUS AI - Environment Variables
# ==========================================

# Application
APP_NAME=NEXUS AI
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_ai

# AI Provider
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embeddings
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Vector Search
VECTOR_DB=pgvector

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Security
SECRET_KEY=